<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 发车前本地提醒(Android 13+ 运行时申请) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 触感反馈/测试震动(HyperOS 等严格校验,缺失时 Material3 组件的 haptic 会抛 SecurityException) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 闹钟式发车提醒的精确闹钟:31/32 自动授予,33+ 由 USE_EXACT_ALARM 授予(个人分发自用) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 写入系统时钟 App 的闹钟(ACTION_SET_ALARM) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ 包可见性:支付时探测支付宝/微信是否安装(resolveActivity 需要) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="alipays" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="weixin" />
        </intent>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.tencent.mm" />
        <!-- 系统时钟:写入发车闹钟(ACTION_SET_ALARM 的 resolveActivity 在 11+ 受包可见性过滤) -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name=".YcApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YC"
        tools:targetApi="s">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 桌面长按快捷方式(静态 shortcuts 为 API 25+,更早版本不显示也无副作用) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.pay.PayActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 闹钟式发车提醒触发点(系统精确闹钟唤起) -->
        <receiver
            android:name=".data.AlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
