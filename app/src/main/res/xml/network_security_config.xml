<?xml version="1.0" encoding="utf-8"?>
<!-- 支付网关 pay.xintuyun.cn 走明文 HTTP,Android 9+ 默认拒绝(ERR_CLEARTEXT_NOT_PERMITTED),
     仅对支付网关这一个域放行,其余(含同站其他子域)仍强制 HTTPS -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">pay.xintuyun.cn</domain>
    </domain-config>
</network-security-config>
