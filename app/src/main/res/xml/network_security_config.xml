<?xml version="1.0" encoding="utf-8"?>
<!-- 支付网关 pay.xintuyun.cn 已实测支持 HTTPS,App 统一把 payUrl 升级为 https 加载;
     此处明文许可仅作为老网关页内嵌 http 子资源/回跳的兜底,仅限该域,其余全部强制 HTTPS -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">pay.xintuyun.cn</domain>
    </domain-config>
</network-security-config>
